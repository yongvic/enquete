# Database — Vercel Postgres (Neon)
# Créez une base sur Vercel Storage ou Neon, puis copiez l'URL
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js — générez avec: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

SUPERADMIN_EMAIL="votre@email.com"

# URL publique de l'app (pour les liens de partage)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Footer — votre identité et réseaux
NEXT_PUBLIC_AUTHOR_NAME="Votre Nom"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/228XXXXXXXX"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/votre-profil"
NEXT_PUBLIC_GITHUB_URL="https://github.com/yongvic"
